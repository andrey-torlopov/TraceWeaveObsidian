{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:traceweave:obsidian-history:1.0",
  "title": "TraceWeave Obsidian History 1.0",
  "description": "Closed history record under _TraceWeave/projects/<projectId>/history/<operationId>.json. Repository runtime additionally validates project identity, revision transitions, receipts, undo/redo eligibility and immutable snapshot barriers.",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "operationId": {
      "$ref": "urn:traceweave:obsidian-project:1.0#/$defs/id"
    },
    "kind": {
      "enum": [
        "command",
        "undo",
        "redo",
        "reconcile",
        "barrier"
      ]
    },
    "target": {
      "$ref": "urn:traceweave:obsidian-project:1.0#/$defs/id"
    },
    "before": {
      "$ref": "urn:traceweave:obsidian-project:1.0"
    },
    "after": {
      "$ref": "urn:traceweave:obsidian-project:1.0"
    }
  },
  "required": [
    "formatVersion",
    "operationId",
    "kind",
    "before",
    "after"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "undo",
              "redo"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "$ref": "urn:traceweave:obsidian-project:1.0#/$defs/id"
          }
        },
        "required": [
          "target"
        ]
      }
    }
  ]
}
