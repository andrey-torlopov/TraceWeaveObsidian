{
  "name": "traceweave-obsidian",
  "version": "0.2.0",
  "description": "Local research graph for Obsidian with centralized metadata and ordinary Markdown notes.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run typecheck && node scripts/build.mjs && node scripts/verify-bundle.mjs",
    "dev": "node scripts/build.mjs --watch",
    "package": "npm run build && node scripts/package.mjs",
    "install:local": "node scripts/install-local.mjs",
    "verify:public": "node scripts/verify-publication.mjs",
    "generate:validators": "node scripts/generate-validators.mjs",
    "pretypecheck": "npm run generate:validators",
    "pretest": "npm run generate:validators",
    "predev": "npm run generate:validators",
    "lint": "eslint src package.json --max-warnings 0"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "ajv": "8.20.0",
    "jsonc-parser": "3.3.1",
    "micromark": "4.0.3",
    "micromark-util-decode-string": "2.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "2.10.3",
    "@types/yazl": "2.4.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "happy-dom": "21.0.3",
    "obsidian": "1.14.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian"
    }
  }
}
